{
  "name": "snappingtool",
  "productName": "SnappingTool",
  "version": "0.2.0",
  "description": "Snap your whole working session — apps, browser tabs, window positions and multi-monitor layout — and bring it all back in one click.",
  "main": "src/main/main.js",
  "author": "SnappingTool Contributors",
  "license": "MIT",
  "homepage": "https://github.com/thuanmitom/snappingtool",
  "repository": {
    "type": "git",
    "url": "https://github.com/thuanmitom/snappingtool.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "node scripts/check-syntax.js",
    "build:win": "electron-builder --win --x64 && node scripts/prepare-download.js",
    "build:portable": "electron-builder --win portable --x64 && node scripts/prepare-download.js",
    "dist": "electron-builder && node scripts/prepare-download.js",
    "prepare-download": "node scripts/prepare-download.js"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.snappingtool.app",
    "productName": "SnappingTool",
    "directories": {
      "output": "../download",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "extension/**/*",
      "!**/*.map"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon_256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  }
}
